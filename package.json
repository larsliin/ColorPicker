{
  "name": "color-picker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.vue",
    "lint:fix": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.vue --fix",
    "build:icons": "node scripts/convert-icons.js",
    "build:favicon": "node scripts/generate-favicon.js",
    "build:extension": "npm run type-check && npm run build:icons && npm run build:favicon && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "chrome-extension-component-library": "github:larsliin/ChromeExtensionsComponentLibrary#main",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@stylistic/eslint-plugin": "^2.11.2",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.10.1",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vue-tsc": "^2.2.0"
  }
}
